{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Forge Runtime User Event 1.0",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "target_id",
    "value",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "value": {},
    "previous_event_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
